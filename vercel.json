{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/home\\.cliniqeo\\.hair\\.jpg",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/greffe-cheveux-turquie",
      "dest": "/index.html"
    },
    {
      "src": "/greffe-cheveux-turquie/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/en/hair-transplant-turkey",
      "dest": "/hair-transplant-turkey"
    },
    {
      "src": "/en/hair-transplant-turkey/(.*)",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
